# Guardian — example environment file.
# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
#
# The backend, frontend (Vite via `envDir`), and WhatsApp bridge all read
# this single root .env file. Only VITE_-prefixed variables are ever
# exposed to the browser bundle — never put secrets behind a VITE_ prefix.

# ---- Backend ----
GUARDIAN_ENV=development
GUARDIAN_DEBUG=true
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000

# Comma-separated list of origins allowed to call the API.
GUARDIAN_CORS_ORIGINS=http://localhost:5173

# ---- WhatsApp Web bridge (Baileys; no Meta Cloud API) ----
WHATSAPP_BACKEND_URL=http://127.0.0.1:8000
# A random secret of at least 32 characters, shared by the bridge and backend.
# Generate one with: openssl rand -hex 32
GUARDIAN_WHATSAPP_BRIDGE_TOKEN=
# Leave empty for terminal QR login; otherwise country code + digits, no '+'.
WHATSAPP_PAIRING_PHONE=

# ---- URL verification (SerpApi) ----
# Live web search for domain evidence, not a safe/scam verdict. Only domains
# are sent to SerpApi, never message bodies or full URL paths/query strings.
# Leave the key empty to run offline signals only; there is no fake fallback.
# Get a key at https://serpapi.com/manage-api-key (not exposed to the browser).
GUARDIAN_SERPAPI_API_KEY=
GUARDIAN_SERPAPI_ENDPOINT=https://serpapi.com/search.json
# Per-request timeout in seconds (>0, at most 30).
GUARDIAN_SERPAPI_TIMEOUT=10
# Retained results from the first page (1–10).
GUARDIAN_SERPAPI_RESULTS_PER_DOMAIN=5
# Maximum paid lookups per message (1–20); repeated domains use one lookup.
GUARDIAN_SERPAPI_MAX_DOMAINS=5

# ---- Gemma risk reasoning ----
# Opt in explicitly: forwarded message text and the existing signals/search
# evidence are sent to this provider. Transport IDs are excluded, but message
# contents may still be sensitive. No key or prompt is exposed to the browser.
GUARDIAN_GEMMA_ENABLED=false
# openrouter, or openai_compatible for another host / your own Gemma server.
GUARDIAN_GEMMA_PROVIDER=openrouter
# Base URL; Guardian appends /chat/completions. HTTPS is required remotely.
# For local vLLM, use openai_compatible and http://127.0.0.1:8001/v1.
GUARDIAN_GEMMA_BASE_URL=https://openrouter.ai/api/v1
# Required for remote inference; optional only for loopback servers.
GUARDIAN_GEMMA_API_KEY=
# An open-weight, instruction-tuned Gemma model (not Gemini).
GUARDIAN_GEMMA_MODEL=google/gemma-3-27b-it
GUARDIAN_GEMMA_TIMEOUT=30
GUARDIAN_GEMMA_MAX_TOKENS=1024
# Reject oversized prompts rather than silently discarding evidence.
GUARDIAN_GEMMA_MAX_INPUT_CHARS=60000
# json_schema, or json_object if the host supports JSON mode only.
# Local schema and evidence-reference validation always remain enabled.
GUARDIAN_GEMMA_RESPONSE_FORMAT=json_schema

# ---- Frontend ----
# Base URL the React app uses to reach the API.
# Leave empty to use the Vite dev proxy (recommended in development).
VITE_API_BASE_URL=

# ---- Reserved for future services (not yet implemented) ----
# Evidence storage / database
# GUARDIAN_DATABASE_URL=
