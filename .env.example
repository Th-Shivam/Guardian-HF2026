# Guardian — example environment file.
# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
#
# Both the backend (pydantic-settings) and the frontend (Vite, via `envDir`)
# read this single root .env file. Only VITE_-prefixed variables are ever
# exposed to the browser bundle — never put secrets behind a VITE_ prefix.

# ---- Backend ----
GUARDIAN_ENV=development
GUARDIAN_DEBUG=true
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000

# Comma-separated list of origins allowed to call the API.
GUARDIAN_CORS_ORIGINS=http://localhost:5173

# ---- WhatsApp ----
# Which provider adapter to use. Currently only "meta" is registered.
GUARDIAN_WHATSAPP_PROVIDER=meta

# Shared secret you also enter in the provider's webhook settings. The GET
# verification endpoint echoes the challenge back only when this matches.
# Must be set — an empty token makes verification fail with a 500 rather than
# accept anything.
GUARDIAN_WHATSAPP_VERIFY_TOKEN=change-me

# ---- Frontend ----
# Base URL the React app uses to reach the API.
# Leave empty to use the Vite dev proxy (recommended in development).
VITE_API_BASE_URL=

# ---- Reserved for future services (not yet implemented) ----
# Outbound WhatsApp delivery (Meta Graph API)
# GUARDIAN_WHATSAPP_ACCESS_TOKEN=
# GUARDIAN_WHATSAPP_PHONE_NUMBER_ID=
#
# AI analysis provider
# GUARDIAN_AI_API_KEY=
#
# URL reputation provider
# GUARDIAN_URL_SCANNER_API_KEY=
#
# Evidence storage / database
# GUARDIAN_DATABASE_URL=
