# Guardian — example environment file.
# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
#
# Both the backend (pydantic-settings) and the frontend (Vite, via `envDir`)
# read this single root .env file. Only VITE_-prefixed variables are ever
# exposed to the browser bundle — never put secrets behind a VITE_ prefix.

# ---- Backend ----
GUARDIAN_ENV=development
GUARDIAN_DEBUG=true
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000

# Comma-separated list of origins allowed to call the API.
GUARDIAN_CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
# Base URL the React app uses to reach the API.
# Leave empty to use the Vite dev proxy (recommended in development).
VITE_API_BASE_URL=

# ---- Reserved for future services (not yet implemented) ----
# WhatsApp Cloud API
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
#
# AI analysis provider
# AI_API_KEY=
#
# URL reputation provider
# URL_SCANNER_API_KEY=
#
# Evidence storage / database
# DATABASE_URL=
